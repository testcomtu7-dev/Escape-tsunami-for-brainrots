-- Оптимизированный цикл перемещения с привязкой к DeltaTime
game:GetService("RunService").Heartbeat:Connect(function(deltaTime)
    -- УСИЛЕННЫЙ CFRAME BOOST
    if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") and customSpeed > 0 then
        local humanoid = Player.Character:FindFirstChildOfClass("Humanoid")
        -- Если игрок зажимает клавиши движения или джойстик
        if humanoid and humanoid.MoveDirection.Magnitude > 0 then
            -- Вычисляем нужное смещение (customSpeed теперь симулирует реальный WalkSpeed)
            local targetVelocity = humanoid.MoveDirection * customSpeed
            Player.Character.HumanoidRootPart.CFrame = Player.Character.HumanoidRootPart.CFrame + (targetVelocity * deltaTime)
        end
    end
    
    if noclipEnabled and Player.Character then
        for _, child in ipairs(Player.Character:GetDescendants()) do
            if child:IsA("BasePart") and child.CanCollide then
                child.CanCollide = false
            end
        end
    end
    
    if tracerEnabled and currentTarget and currentTarget.Parent then
        local targetPart = currentTarget:IsA("Model") and (currentTarget.PrimaryPart or currentTarget:FindFirstChildWhichIsA("BasePart")) or currentTarget
        if targetPart then
            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
            if onScreen then
                Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                Line.To = Vector2.new(screenPos.X, screenPos.Y)
                Line.Visible = true
                return
            end
        end
    end
    Line.Visible = false
end)

