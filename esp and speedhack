local function getRareValue(object)
    if not object or object == Player.Character or object:IsDescendantOf(Player.Character) then return 0 end
    local nameLower = string.lower(object.Name)
    for i = #RARE_KEYWORDS, 1, -1 do
        if string.find(nameLower, string.lower(RARE_KEYWORDS[i])) then return i end
    end
    return 0
end

local function clearESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        local hl = obj:FindFirstChild("RareHighlight")
        if hl then hl:Destroy() end
    end
end

local Line = Drawing.new("Line")
Line.Visible = false
Line.Color = Color3.fromRGB(255, 215, 0)
Line.Thickness = 2
Line.Transparency = 0.8

task.spawn(function()
    while true do
        task.wait(1.5)
        if espEnabled or tracerEnabled then
            local highestValue = 0
            local bestObj = nil
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") or (obj:IsA("BasePart") and obj.Parent == workspace) then
                    local val = getRareValue(obj)
                    if val > 0 then
                        if espEnabled and not obj:FindFirstChild("RareHighlight") then
                            local hl = Instance.new("Highlight")
                            hl.Name = "RareHighlight"
                            hl.FillColor = (val >= #RARE_KEYWORDS-1) and Color3.fromRGB(255, 0, 255) or Color3.fromRGB(0, 255, 0)
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            hl.FillTransparency = 0.6
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Parent = obj
                        end
                        if val > highestValue then
                            highestValue = val
                            bestObj = obj
                        end
                    end
                end
            end
            currentTarget = bestObj
        end
    end
end)

