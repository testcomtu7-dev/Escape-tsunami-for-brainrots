SpeedInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local value = tonumber(SpeedInput.Text)
        if value then
            customSpeed = value
            SpeedInput.Text = "Скорость: " .. value
            SpeedInput.BackgroundColor3 = Color3.fromRGB(50, 150, 255)
        else
            customSpeed = 0
            SpeedInput.Text = ""
            SpeedInput.PlaceholderText = "Введи число!"
            SpeedInput.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
        end
    end
end)

